{
  "name": "bop-evolve-desktop",
  "productName": "BOP Evolve",
  "version": "0.1.0",
  "description": "BOP Evolve desktop client (Windows, macOS, Linux). Connects to the Dockerized BOP Evolve server. Demo data only.",
  "author": {
    "name": "BOP Evolve prototype team",
    "email": "bop-evolve@example.invalid"
  },
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "dev": "node scripts/dev.mjs",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "dist:linux": "npm run build:renderer && electron-builder --linux",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/settings.js"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "homepage": "https://github.com/abuwalid1998/BOP-Evolve"
}
