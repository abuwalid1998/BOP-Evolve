# Copy to .env for local overrides. Safe, local-only demo values.
# Production secrets and connection strings must come from the bank's approved secrets manager.
APP_ENV=development
DEMO_MODE=true
AUTH_MODE=mock
LOG_LEVEL=INFO

POSTGRES_USER=bop_evolve
POSTGRES_PASSWORD=bop_evolve_local
POSTGRES_DB=bop_evolve_dev

JWT_SECRET=local-dev-only-change-me
DEMO_PASSWORD=Evolve#Demo2026
# Separate demo password for the Chief HR Officer account (hr.chief).
HR_CHIEF_PASSWORD=123
SESSION_TTL_MINUTES=480

API_PORT=8000
WEB_PORT=8080
WORKER_TICK_SECONDS=10

# Configuration screen (database connections)
# Fernet key for saved connection passwords: 32 random bytes, url-safe base64. Empty = derived from JWT_SECRET (dev only).
CONFIG_SECRET_KEY=
# Comma-separated hosts the Configuration screen may connect to (wildcards allowed). Empty = any host in development.
DB_CONNECTION_ALLOWED_HOSTS=
